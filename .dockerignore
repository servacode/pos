# Build context for apps/api/Dockerfile and apps/web/Dockerfile (both build from the repo root).
# Secrets, local data and build output never enter an image.
**/node_modules
**/dist
**/coverage
**/.turbo
**/*.log
**/.env
**/.env.*
!.env.example
.git
.github
.claude
docs
deploy/local/backups
deploy/local/*.crt
# Test and mutation reports at a package root only (not source folders such as src/admin/reports)
apps/*/reports
packages/*/reports
**/.stryker-tmp
