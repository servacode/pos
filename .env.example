# Local development settings. Production uses real environment variables (NODE_ENV=production),
# where development passwords, Secure-less cookies and logged sign-up codes are refused at startup.

# Runtime connection: the restricted app role (subject to row-level security)
DATABASE_URL=postgres://serva_app:serva_app@localhost:5432/serva
# Migration connection: the owner role (owns the tables)
DATABASE_MIGRATION_URL=postgres://serva_owner:serva_owner@localhost:5432/serva
# Required, no default: generate your own with `openssl rand -base64 48`.
# Example values, short or predictable secrets are refused at startup.
JWT_SECRET=
# During a rotation: former JWT_SECRET values (comma-separated) still accepted for existing tokens
# JWT_PREVIOUS_SECRETS=
PORT=3000
# Listens on 127.0.0.1 by default; development mode is refused on any other address.
# HOST=127.0.0.1
# Behind a proxy: its addresses or CIDR ranges (never "true", never a hop count), e.g. 127.0.0.1
# TRUST_PROXY=false
# With TRUST_PROXY listing Cloudflare's ranges: CLIENT_IP_HEADER=cf-connecting-ip
# The refresh cookie is Secure (browsers accept it on http://localhost); false only outside production.
# COOKIE_SECURE=true
# Sign-up codes: "log" prints them in the API log (development); "none" turns sign-up off.
# OTP_DELIVERY=log
# The local server only (DEPLOYMENT=local): "screen" shows the code on the sign-up screen (test mode).
# DEPLOYMENT=cloud
# First platform admin, created by `pnpm db:seed`
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-please
