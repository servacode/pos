# Local development settings. Production uses real environment variables (NODE_ENV=production),
# where development passwords, Secure-less cookies and logged sign-up codes are refused at startup.

# Runtime connection: the restricted app role (subject to row-level security)
DATABASE_URL=postgres://serva_app:serva_app@localhost:5432/serva
# Migration connection: the owner role (owns the tables)
DATABASE_MIGRATION_URL=postgres://serva_owner:serva_owner@localhost:5432/serva
# Required, no default: generate your own with `openssl rand -base64 48`.
# Example values, short or predictable secrets are refused at startup.
JWT_SECRET=
# During a rotation: former JWT_SECRET values (comma-separated) still accepted for existing tokens
# JWT_PREVIOUS_SECRETS=
PORT=3000
# Listens on 127.0.0.1 by default; development mode is refused on any other address.
# HOST=127.0.0.1
# Behind a proxy: its addresses or CIDR ranges (never "true", never a hop count), e.g. 127.0.0.1
# TRUST_PROXY=false
# With TRUST_PROXY listing Cloudflare's ranges: CLIENT_IP_HEADER=cf-connecting-ip
# The refresh cookie is Secure (browsers accept it on http://localhost); false only outside production.
# COOKIE_SECURE=true
# Sign-up codes: "log" prints them in the API log (development); "none" turns sign-up off.
# OTP_DELIVERY=log
# "gateway" hands the code to a sending service (WhatsApp bot, SMS) at this URL with this token:
# OTP_GATEWAY_URL=https://bot.example/send
# OTP_GATEWAY_TOKEN=a-long-random-secret
# "sms" calls any HTTP SMS provider. {phone} (+9639…), {digits} (9639…), {code} and {message} are
# filled in, escaped for where they land; the URL or the body must contain {message} or {code}.
# https:// is required on the cloud in production. The auth header is one "Name: value" line.
# SMS_GATEWAY_URL=https://sms.example/v1/messages
# SMS_GATEWAY_METHOD=POST
# SMS_GATEWAY_AUTH_HEADER=Authorization: Bearer a-long-random-secret
# SMS_GATEWAY_CONTENT_TYPE=application/json
# SMS_GATEWAY_BODY={"to":"{phone}","text":"{message}"}
# Broadcast messages to customers by SMS too (each one is paid; default false):
# SMS_ALLOW_BROADCASTS=false
# A second channel tried when OTP_DELIVERY fails: "gateway" after "sms", or "sms" after "gateway".
# OTP_FALLBACK=gateway
# Error reports in the Sentry protocol (Sentry or self-hosted GlitchTip). Off unless set. Only the
# error type, a scrubbed message, the stack and the route pattern are sent; https:// on the cloud.
# SENTRY_DSN=https://publickey@glitchtip.example/1
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# The local server only (DEPLOYMENT=local): "screen" shows the code on the sign-up screen (test mode).
# DEPLOYMENT=cloud
# First platform admin, created by `pnpm db:seed`
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-please
# Platform team two-factor sign-in (TOTP). Default: true in production, false elsewhere.
# A member without it is made to enrol at the next sign-in.
# PLATFORM_REQUIRE_2FA=true
# Forgotten-password codes: per phone and per address, per hour
# RESET_PHONE_LIMIT_PER_HOUR=5
# RESET_IP_LIMIT_PER_HOUR=20
